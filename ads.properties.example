# Copy to ads.properties (gitignored) and fill in the real ids from the AdMob
# console. Any build without that file uses Google's public test ids, which
# never earn revenue and are safe to click.
admobAppId=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
admobBannerUnitId=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
