<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer for Android 13+. Same geometry as the foreground, drawn
  in one colour: the system ignores these colours and tints by alpha to match
  the user's wallpaper. Without this the icon stays full-colour on a themed
  home screen while the system apps tint, which is what it did before.
  Keep in step with ic_launcher_foreground.xml by hand — nothing enforces it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- waveform bars, outer pair shortest -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22.5,50.5 A1.5,1.5 0 0 1 25.5,50.5 L25.5,57.5 A1.5,1.5 0 0 1 22.5,57.5 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M28.5,45.5 A1.5,1.5 0 0 1 31.5,45.5 L31.5,62.5 A1.5,1.5 0 0 1 28.5,62.5 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34.5,49 A1.5,1.5 0 0 1 37.5,49 L37.5,59 A1.5,1.5 0 0 1 34.5,59 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M70.5,49 A1.5,1.5 0 0 1 73.5,49 L73.5,59 A1.5,1.5 0 0 1 70.5,59 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M76.5,45.5 A1.5,1.5 0 0 1 79.5,45.5 L79.5,62.5 A1.5,1.5 0 0 1 76.5,62.5 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M82.5,50.5 A1.5,1.5 0 0 1 85.5,50.5 L85.5,57.5 A1.5,1.5 0 0 1 82.5,57.5 Z" />

    <!-- capsule -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46.5,42 A7.5,7.5 0 0 1 61.5,42 L61.5,50 A7.5,7.5 0 0 1 46.5,50 Z" />
    <!-- cradle: lower half of a circle, so sweep-flag 0 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M41,51.5 A13,13 0 0 0 67,51.5" />
    <!-- stem -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52.5,63 A1.5,1.5 0 0 1 55.5,63 L55.5,68 A1.5,1.5 0 0 1 52.5,68 Z" />
    <!-- base -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,69.5 L62,69.5 A2,2 0 0 1 62,73.5 L46,73.5 A2,2 0 0 1 46,69.5 Z" />
</vector>
