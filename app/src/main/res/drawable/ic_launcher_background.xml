<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. The gradient matches store/icon-512.png so the
  launcher icon and the Play listing icon read as the same app; they are
  separate assets with nothing keeping them in sync, so edit them together.
  Launchers crop to the centre 72 of these 108 units, which is why the
  gradient has to look right across the middle rather than corner to corner.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0" android:color="#FF0F2A43" />
                <item android:offset="1" android:color="#FF00685E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
