<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: microphone plus waveform bars, matching
  store/icon-512.png.

  Everything here sits inside the 66-unit safe-zone circle centred on
  (54,54) — content outside that is cropped by round and squircle masks.
  That is why this is a redraw rather than a copy of the 512px store icon:
  that one's outermost bar and the two rules under the mic fall outside the
  crop entirely. The previous version of this file used the stock 24dp
  Material mic glyph at its native size, which came out 14 units wide — a
  fifth of the safe zone — and read as a speck on the home screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- waveform bars, outer pair shortest -->
    <path
        android:fillColor="#7FD1C8"
        android:pathData="M22.5,50.5 A1.5,1.5 0 0 1 25.5,50.5 L25.5,57.5 A1.5,1.5 0 0 1 22.5,57.5 Z" />
    <path
        android:fillColor="#7FD1C8"
        android:pathData="M28.5,45.5 A1.5,1.5 0 0 1 31.5,45.5 L31.5,62.5 A1.5,1.5 0 0 1 28.5,62.5 Z" />
    <path
        android:fillColor="#7FD1C8"
